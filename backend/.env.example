# Copy to .env (never commit .env)

# SQLite file for saved sessions. Swap for a PostgreSQL URL later.
# MUSELAB_DATABASE_URL=sqlite:///./data/muselab.db

# Comma-separated list of frontend origins allowed to call this API.
# Be explicit. Do NOT use "*" in production: any website could then call your API from a visitor's browser.
MUSELAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Upload limits
MUSELAB_MAX_UPLOAD_MB=25
MUSELAB_MAX_DURATION_SECONDS=180
MUSELAB_ANALYSIS_TIMEOUT_SECONDS=120

# Analysis sample rate (audio is never upsampled beyond its original rate)
MUSELAB_ANALYSIS_SAMPLE_RATE=22050

# Max points per chart series returned by the API
MUSELAB_MAX_CHART_POINTS=800

# Optional: folder for temporary uploads (defaults to the system temp folder)
# MUSELAB_TEMP_DIR=
